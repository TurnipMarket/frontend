# Copiá este archivo a .env.local y editá los valores cuando exista backend real.

# URL base del backend (sin barra final). Vacío = no se usa (modo mock).
VITE_API_BASE_URL=

# true  = no llama a ningún backend, simula la respuesta (default para desarrollo sin backend)
# false = hace fetch real a VITE_API_BASE_URL + /api/auth/login
VITE_MOCK_MODE=true
